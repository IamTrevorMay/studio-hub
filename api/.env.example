# Post-Show API — copy this to .env and fill in values

PORT=4400

# ── Video ──────────────────────────────────────────────────────────────
# Directory where source recordings are stored (the folder you point to in settings)
VIDEO_SOURCE_DIR=/Users/trevor/Desktop/Recordings

# Directory where cut clips are saved before Drive upload
VIDEO_OUTPUT_DIR=/Users/trevor/Desktop/Mayday-Clips

# ── Google Drive ───────────────────────────────────────────────────────
# Path to your Google service account JSON credentials file
GOOGLE_SERVICE_ACCOUNT_PATH=/Users/trevor/.secrets/google-service-account.json

# Root Drive folder ID — clips are uploaded inside subfolders of this folder
# e.g. if Aaron's folder path is "Editors/Aaron/Shorts", it goes inside this root
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Discord ────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ── Supabase ───────────────────────────────────────────────────────────
SUPABASE_URL=
# Use the SERVICE ROLE key (not the anon key) — keep this secret, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# Supabase user ID to use as "created_by" for Kanban cards (your user ID)
KANBAN_CREATED_BY_USER_ID=

# Supabase user ID for Alana (used as assigned_to on auto-synced shorts)
ALANA_USER_ID=
